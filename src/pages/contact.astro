---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact Us | Get a Quote for Fishing Line Counters',
  description: 'Contact WENMENGHE for fishing line counter OEM and wholesale inquiries. We reply within 24 hours.',
};
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-2xl px-4 py-20 text-center sm:px-6">
    <p class="text-base font-semibold uppercase tracking-wide text-secondary dark:text-blue-200">Contact</p>
    <h1 class="mt-2 text-4xl font-bold md:text-5xl">Request a Quote</h1>
    <p class="mt-4 text-muted">
      Send us your requirements, including product type, quantity, custom logo and packaging.
      We will reply within 24 hours.
    </p>

    <div class="mt-10 rounded-xl border border-gray-200 bg-white p-8 shadow-sm dark:border-gray-700 dark:bg-slate-800">
      <p class="text-sm uppercase tracking-wide text-muted">Email</p>
      <p class="mt-2 text-2xl font-bold">startfromfeelings@gmail.com</p>
      <a href="mailto:startfromfeelings@gmail.com?subject=Inquiry%20about%20Fishing%20Line%20Counters" class="btn-primary mt-6 inline-block">
        Send Email
      </a>
    </div>

    <p class="mt-8 text-sm text-muted">MOQ 1,000 pcs · OEM available · Worldwide shipping</p>
  </section>
</Layout>
