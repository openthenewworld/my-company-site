---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact Us | Get a Quote for Ice Fishing Reels',
  description: 'Contact WENMENGHE by WhatsApp or email for OEM and wholesale inquiries. We reply within 24 hours.',
};

const email = 'startfromfeelings@gmail.com';
const whatsappDisplay = '+86 155 8862 4891';
const whatsappLink =
  'https://wa.me/8615588624891?text=Hello%2C%20I%20am%20interested%20in%20your%20ice%20fishing%20reels.%20Please%20send%20me%20a%20quotation.';
const mailLink = `mailto:${email}?subject=Inquiry%20about%20Ice%20Fishing%20Reels`;

const checklist = [
  'Product you are interested in',
  'Quantity (MOQ is 1,000 pcs)',
  'Custom logo, color or packaging requirements',
  'Destination country',
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <p class="text-center text-base font-semibold uppercase tracking-wide text-secondary dark:text-blue-200">Contact</p>
    <h1 class="mt-2 text-center text-4xl font-bold md:text-5xl">Request a Quote</h1>
    <p class="mx-auto mt-4 max-w-xl text-center text-muted">
      Contact us by WhatsApp or email. We reply to every inquiry within 24 hours.
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-gray-700 dark:bg-slate-800">
        <p class="text-sm font-semibold uppercase tracking-wide text-muted">WhatsApp</p>
        <p class="mt-2 text-xl font-bold">{whatsappDisplay}</p>
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="btn-primary mt-6 inline-block">
          Chat on WhatsApp
        </a>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-8 text-center shadow-sm dark:border-gray-700 dark:bg-slate-800">
        <p class="text-sm font-semibold uppercase tracking-wide text-muted">Email</p>
        <p class="mt-2 break-all text-xl font-bold">{email}</p>
        <a href={mailLink} class="btn-primary mt-6 inline-block">Send Email</a>
      </div>
    </div>

    <div class="mt-10 rounded-xl bg-gray-50 p-8 dark:bg-slate-800">
      <h2 class="text-xl font-bold">To get a faster quotation, please tell us:</h2>
      <ul class="mt-4 space-y-2">
        {checklist.map((c) => <li>✓ {c}</li>)}
      </ul>
    </div>

    <p class="mt-8 text-center text-sm text-muted">MOQ 1,000 pcs · OEM available · Worldwide shipping</p>
  </section>
</Layout>
