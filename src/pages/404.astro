---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Fishing Line Counters | OEM & Wholesale Products',
  description: 'Fishing line counters for OEM and wholesale. MOQ 1,000 pcs, custom logo, color and packaging.',
};

const products = [
  {
    name: '[Product name 1]',
    desc: '[One sentence: what it is and who it is for]',
    specs: ['[Spec 1, e.g. measuring range]', '[Spec 2, e.g. material]', '[Spec 3]'],
  },
  {
    name: '[Product name 2]',
    desc: '[One sentence description]',
    specs: ['[Spec 1]', '[Spec 2]', '[Spec 3]'],
  },
  {
    name: '[Product name 3]',
    desc: '[One sentence description]',
    specs: ['[Spec 1]', '[Spec 2]', '[Spec 3]'],
  },
];

const options = [
  'Custom logo (laser engraving or printing)',
  'Custom color',
  'Custom packaging and labels',
  'Private label for your brand',
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <p class="text-center text-base font-semibold uppercase tracking-wide text-secondary dark:text-blue-200">Products</p>
    <h1 class="mt-2 text-center text-4xl font-bold md:text-5xl">Fishing Line Counters</h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-muted">
      OEM and wholesale supply for tackle brands and distributors. MOQ 1,000 pcs.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        products.map((p) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-slate-800">
            <h2 class="text-xl font-bold">{p.name}</h2>
            <p class="mt-2 text-muted">{p.desc}</p>
            <ul class="mt-4 space-y-1 text-sm">
              {p.specs.map((s) => <li>• {s}</li>)}
            </ul>
            <a href="/contact" class="btn-primary mt-6 inline-block">Request a Quote</a>
          </div>
        ))
      }
    </div>

    <div class="mt-16 rounded-xl bg-gray-50 p-8 dark:bg-slate-800">
      <h2 class="text-2xl font-bold">OEM / Customization Options</h2>
      <ul class="mt-4 space-y-2">
        {options.map((o) => <li>✓ {o}</li>)}
      </ul>
      <p class="mt-4 text-muted">MOQ 1,000 pcs per order. Samples available on request.</p>
    </div>

    <div class="mt-12 text-center">
      <a href="/contact" class="btn-primary">Send Your Inquiry</a>
    </div>
  </section>
</Layout>
