---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'OEM & ODM Fishing Line Counters | Custom Logo, Color, Packaging',
  description: 'OEM and private label fishing line counters. Custom logo, color and packaging. MOQ 1,000 pcs.',
};

const options = [
  { title: 'Custom Logo', text: 'Your brand logo by laser engraving or printing.' },
  { title: 'Custom Color', text: 'Choose body and accent colors to match your brand.' },
  { title: 'Custom Packaging', text: 'Retail boxes, blister packs, labels and inserts.' },
  { title: 'Private Label', text: 'Sell under your own brand name with full support.' },
];

const steps = [
  { title: 'Send Your Inquiry', text: 'Tell us the product, quantity and customization you need.' },
  { title: 'Quote & Samples', text: 'We confirm details, send a quotation and arrange samples.' },
  { title: 'Order & Production', text: 'After sample approval and deposit, mass production starts.' },
  { title: 'Inspection & Shipping', text: 'We inspect the goods and ship to your destination.' },
];

const faqs = [
  { q: 'What is your MOQ?', a: 'Our MOQ is 1,000 pcs per order.' },
  { q: 'Can I get samples before ordering?', a: 'Yes. Contact us for sample details and arrangement.' },
  { q: 'Can you make products with my own logo and packaging?', a: 'Yes. We support custom logo, color and packaging.' },
  { q: 'Do you ship worldwide?', a: 'Yes. We ship to customers and distributors worldwide.' },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-center text-base font-semibold uppercase tracking-wide text-secondary dark:text-blue-200">OEM Service</p>
    <h1 class="mt-2 text-center text-4xl font-bold md:text-5xl">OEM &amp; Private Label Line Counters</h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-muted">
      Build your own fishing line counter brand with us. Custom logo, color and packaging, starting from 1,000 pcs.
    </p>
    <div class="mt-6 text-center">
      <a href="/contact" class="btn-primary">Request a Quote</a>
    </div>

    <h2 class="mt-16 text-center text-3xl font-bold">What You Can Customize</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        options.map((o) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-slate-800">
            <h3 class="text-xl font-bold">{o.title}</h3>
            <p class="mt-2 text-muted">{o.text}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-16 text-center text-3xl font-bold">How We Work Together</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="rounded-xl bg-gray-50 p-6 dark:bg-slate-800">
            <div class="text-3xl font-bold text-primary">{i + 1}</div>
            <h3 class="mt-2 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <h2 class="mt-16 text-center text-3xl font-bold">FAQ</h2>
    <div class="mt-8 space-y-4">
      {
        faqs.map((f) => (
          <div class="rounded-xl border border-gray-200 p-5 dark:border-gray-700">
            <h3 class="font-bold">{f.q}</h3>
            <p class="mt-1 text-muted">{f.a}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-16 rounded-xl bg-gray-50 p-10 text-center dark:bg-slate-800">
      <h2 class="text-2xl font-bold">Ready to Start Your Custom Order?</h2>
      <p class="mt-2 text-muted">Send us your requirements. We reply within 24 hours.</p>
      <a href="/contact" class="btn-primary mt-6 inline-block">Get a Free Quote</a>
    </div>
  </section>
</Layout>
