---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Fishing Line Counter Manufacturer | OEM & Wholesale Supplier',
  description:
    'Wholesale and OEM fishing line counters. MOQ 1,000 pcs, custom logo and packaging, worldwide shipping.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero
    tagline="Fishing Line Counter Manufacturer"
    actions={[
      { variant: 'primary', text: 'Request a Quote', href: '/contact' },
      { text: 'Our Advantages', href: '#advantages' },
    ]}
  >
    <Fragment slot="title">
      Fishing Line Counters for <span class="text-accent dark:text-white">OEM & Wholesale</span>
    </Fragment>
    <Fragment slot="subtitle">
      We supply accurate, durable line counters for fishing reels and tackle brands worldwide. MOQ 1,000 pcs. Custom
      logo, color and packaging available.
    </Fragment>
  </Hero>

  <Features
    id="advantages"
    tagline="Why Choose Us"
    title="Your Reliable Line Counter Supplier"
    subtitle="From custom design to bulk delivery, we help tackle brands and distributors get the product they need."
    columns={3}
    items={[
      {
        title: 'OEM / ODM Service',
        description: 'Custom logo, color, size and packaging to match your brand.',
        icon: 'tabler:settings',
      },
      {
        title: 'Accurate Measurement',
        description: 'Reliable line length tracking for anglers who care about precision.',
        icon: 'tabler:ruler',
      },
      {
        title: 'Quality Control',
        description: 'Products are inspected before shipment to keep quality consistent.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Wholesale-Friendly MOQ',
        description: 'Start from 1,000 pcs per order, with flexible mixed options.',
        icon: 'tabler:package',
      },
      {
        title: 'Worldwide Shipping',
        description: 'We ship to distributors and brands across the globe.',
        icon: 'tabler:truck-delivery',
      },
      {
        title: 'Fast Response',
        description: 'Send us your requirements and we will reply within 24 hours.',
        icon: 'tabler:message-circle',
      },
    ]}
  />

  <CallToAction
    actions={[{ variant: 'primary', text: 'Get a Free Quote', href: '/contact' }]}
  >
    <Fragment slot="title">Looking for a Reliable Line Counter Supplier?</Fragment>
    <Fragment slot="subtitle">
      Send us your requirements. We will reply with a quote and sample options within 24 hours.
    </Fragment>
  </CallToAction>
</Layout>
