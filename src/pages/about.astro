---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About WENMENGHE | Ice Fishing Reel OEM & Wholesale Supplier',
  description:
    'WENMENGHE supplies ice fishing reels and fishing tackle products for brands and distributors worldwide. OEM customization, MOQ 1,000 pcs.',
};

const strengths = [
  { title: 'Focused on Fishing Tackle', text: 'We concentrate on ice fishing reels and related tackle products, so we understand what buyers in this market need.' },
  { title: 'OEM / ODM Customization', text: 'Custom logo, color and packaging to build your own brand.' },
  { title: 'Wholesale-Friendly MOQ', text: 'Orders start from 1,000 pcs, suitable for brands and distributors.' },
  { title: 'Clear, Fast Communication', text: 'We reply to inquiries within 24 hours with a clear quotation and sample options.' },
];

const steps = [
  { title: 'Tell Us What You Need', text: 'Share the product type, quantity and any customization.' },
  { title: 'Confirm Details & Samples', text: 'We confirm specifications, quote, and arrange samples for approval.' },
  { title: 'Production & Inspection', text: 'After confirmation, we produce your order and check the goods before shipment.' },
  { title: 'Worldwide Shipping', text: 'We ship to your destination and keep you updated until delivery.' },
];
---

<Layout metadata={metadata}>
  <section class="mx-auto max-w-5xl px-4 py-16 sm:px-6">
    <p class="text-center text-base font-semibold uppercase tracking-wide text-secondary dark:text-blue-200">About Us</p>
    <h1 class="mt-2 text-center text-4xl font-bold md:text-5xl">Your Partner for Ice Fishing Reels</h1>
    <p class="mx-auto mt-4 max-w-2xl text-center text-muted">
      WENMENGHE supplies ice fishing reels and fishing tackle products to brands, importers and distributors worldwide.
    </p>

    <div class="mx-auto mt-12 max-w-3xl space-y-4 text-lg leading-relaxed">
      <p>
        We help overseas buyers get reliable fishing tackle products with customization that fits their brand. From the
        first inquiry to final shipment, we keep the process simple and communication clear.
      </p>
      <p>
        Whether you are launching a new product line or looking for a steady supply for your market, we work with you on
        logo, color and packaging, and support orders starting from 1,000 pcs.
      </p>
    </div>

    <h2 class="mt-16 text-center text-3xl font-bold">Why Work With Us</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        strengths.map((s) => (
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm dark:border-gray-700 dark:bg-slate-800">
            <h3 class="text-xl font-bold">{s.title}</h3>
            <p class="mt-2 text-muted">{s.text}</p>
          </div>
        ))
      }
    </div>

    <h2 class="mt-16 text-center text-3xl font-bold">How We Work</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        steps.map((s, i) => (
          <li class="rounded-xl bg-gray-50 p-6 dark:bg-slate-800">
            <div class="text-3xl font-bold text-primary">{i + 1}</div>
            <h3 class="mt-2 text-lg font-bold">{s.title}</h3>
            <p class="mt-2 text-sm text-muted">{s.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-16 rounded-xl bg-gray-50 p-10 text-center dark:bg-slate-800">
      <h2 class="text-2xl font-bold">Let's Talk About Your Project</h2>
      <p class="mt-2 text-muted">Send us your requirements and we will reply within 24 hours.</p>
      <a href="/contact" class="btn-primary mt-6 inline-block">Request a Quote</a>
    </div>
  </section>
</Layout>
