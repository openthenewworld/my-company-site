---
const pageTitle = "About Us | WENMENGHE";
const pageDescription =
  "WENMENGHE is a China-based sourcing and export business focused on fishing line counters and fishing tackle products.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="nav-container">
        <a class="logo" href="/">WENMENGHE</a>

        <nav aria-label="Main navigation">
          <a href="/">Home</a>
          <a href="/services/">OEM Service</a>
          <a href="/contact/">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">ABOUT US</p>
          <h1>Connecting Fishing Tackle Buyers with China</h1>
          <p class="hero-description">
            Practical sourcing and export support for fishing line counters
            and related fishing tackle products.
          </p>
        </div>
      </section>

      <section class="content-section">
        <div class="content-container">

          <div class="intro">
            <p class="section-label">WHO WE ARE</p>
            <h2>A Practical Partner for Product Sourcing</h2>

            <p>
              WENMENGHE is a China-based sourcing and export business focused
              on fishing line counters and related fishing tackle products.
            </p>

            <p>
              We help overseas buyers explore suitable products and connect
              with manufacturers and suppliers in China. Our work focuses on
              product sourcing, customization coordination, packaging
              arrangements, and export support.
            </p>

            <p>
              We believe good business starts with clear communication,
              realistic product information, and a practical understanding
              of each customer's requirements.
            </p>
          </div>

          <div class="divider"></div>

          <section class="services">
            <p class="section-label">WHAT WE DO</p>
            <h2>How We Can Help</h2>

            <div class="service-grid">
              <article class="service-card">
                <div class="service-number">01</div>
                <h3>Product Sourcing</h3>
                <p>
                  Identify suitable fishing line counters and related
                  fishing tackle products based on your requirements.
                </p>
              </article>

              <article class="service-card">
                <div class="service-number">02</div>
                <h3>OEM Coordination</h3>
                <p>
                  Coordinate logo, color, and product customization
                  requirements with suitable suppliers.
                </p>
              </article>

              <article class="service-card">
                <div class="service-number">03</div>
                <h3>Packaging Solutions</h3>
                <p>
                  Discuss packaging and labeling requirements for wholesale
                  and private-label orders.
                </p>
              </article>

              <article class="service-card">
                <div class="service-number">04</div>
                <h3>Export Support</h3>
                <p>
                  Assist with supplier communication, order coordination,
                  and shipping arrangements.
                </p>
              </article>
            </div>
          </section>

          <div class="divider"></div>

          <section class="approach">
            <p class="section-label">OUR APPROACH</p>
            <h2>Clear Communication. Practical Solutions.</h2>

            <div class="approach-list">
              <div class="approach-item">
                <span class="check">✓</span>
                <div>
                  <h3>Understand Your Requirements</h3>
                  <p>
                    We first learn about your target product, quantity,
                    market, and customization needs.
                  </p>
                </div>
              </div>

              <div class="approach-item">
                <span class="check">✓</span>
                <div>
                  <h3>Explore Suitable Suppliers</h3>
                  <p>
                    We work to identify suitable sourcing options according
                    to your product requirements.
                  </p>
                </div>
              </div>

              <div class="approach-item">
                <span class="check">✓</span>
                <div>
                  <h3>Confirm Details Before Ordering</h3>
                  <p>
                    Product specifications, pricing, customization,
                    quantities, and delivery arrangements should be
                    confirmed before an order is placed.
                  </p>
                </div>
              </div>
            </div>
          </section>

          <section class="contact-cta">
            <p class="section-label">LET'S TALK</p>
            <h2>Looking for Fishing Line Counters?</h2>
            <p>
              Tell us what products you need, your estimated order quantity,
              and any customization requirements. We would be glad to discuss
              possible sourcing solutions.
            </p>
            <a class="cta-button" href="/contact/">
              Contact Us
            </a>
          </section>

        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-container">
        <div>
          <a class="footer-logo" href="/">WENMENGHE</a>
          <p>
            Fishing line counters and sourcing support for overseas buyers.
          </p>
        </div>

        <div class="footer-links">
          <a href="/">Home</a>
          <a href="/services/">OEM Service</a>
          <a href="/contact/">Contact</a>
        </div>

        <p class="copyright">
          © {new Date().getFullYear()} WENMENGHE. All rights reserved.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  :root {
    font-family: Arial, Helvetica, sans-serif;
    color: #1d2939;
    background: #ffffff;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    line-height: 1.7;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-header {
    width: 100%;
    background: #ffffff;
    border-bottom: 1px solid #e8edf2;
  }

  .nav-container {
    max-width: 1160px;
    min-height: 76px;
    margin: auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .logo,
  .footer-logo {
    font-size: 21px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #163b35;
  }

  nav {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  nav a {
    color: #475467;
    font-size: 14px;
    font-weight: 600;
  }

  nav a:hover,
  .footer-links a:hover {
    color: #16846c;
  }

  .hero {
    background: #153d35;
    color: #ffffff;
    padding: 100px 24px 105px;
  }

  .hero-content {
    max-width: 1120px;
    margin: auto;
  }

  .eyebrow,
  .section-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 2px;
  }

  .eyebrow {
    color: #a9d9c7;
  }

  .hero h1 {
    max-width: 760px;
    margin: 18px 0;
    font-size: clamp(36px, 5vw, 58px);
    line-height: 1.15;
    letter-spacing: -1.5px;
  }

  .hero-description {
    max-width: 620px;
    color: #d6e6df;
    font-size: 18px;
  }

  .content-section {
    padding: 80px 24px;
  }

  .content-container {
    max-width: 1080px;
    margin: auto;
  }

  .intro {
    max-width: 800px;
  }

  .section-label {
    color: #16846c;
  }

  h2 {
    margin: 10px 0 24px;
    color: #172b27;
    font-size: clamp(27px, 3.5vw, 38px);
    line-height: 1.25;
  }

  .intro p:not(.section-label) {
    color: #56636f;
    font-size: 16px;
    margin: 15px 0;
  }

  .divider {
    height: 1px;
    margin: 65px 0;
    background: #e7ece9;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin-top: 35px;
  }

  .service-card {
    padding: 28px;
    border: 1px solid #e4ebe7;
    border-radius: 10px;
    background: #ffffff;
  }

  .service-number {
    color: #16846c;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 1px;
  }

  .service-card h3,
  .approach-item h3 {
    margin: 12px 0 8px;
    color: #1d3932;
    font-size: 19px;
  }

  .service-card p,
  .approach-item p {
    margin: 0;
    color: #66736f;
    font-size: 15px;
  }

  .approach-list {
    display: grid;
    gap: 26px;
    margin-top: 35px;
    max-width: 820px;
  }

  .approach-item {
    display: flex;
    align-items: flex-start;
    gap: 17px;
  }

  .check {
    display: flex;
    flex: 0 0 30px;
    width: 30px;
    height: 30px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #e8f4ef;
    color: #16846c;
    font-weight: 800;
  }

  .approach-item h3 {
    margin-top: 0;
  }

  .contact-cta {
    margin-top: 75px;
    padding: 55px 40px;
    border-radius: 12px;
    background: #f1f6f3;
    text-align: center;
  }

  .contact-cta p:not(.section-label) {
    max-width: 650px;
    margin: 0 auto 25px;
    color: #66736f;
  }

  .cta-button {
    display: inline-block;
    padding: 13px 28px;
    border-radius: 5px;
    background: #176b57;
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    transition: background 0.2s ease;
  }

  .cta-button:hover {
    background: #104c3e;
  }

  .site-footer {
    padding: 45px 24px;
    background: #153d35;
    color: #d6e6df;
  }

  .footer-container {
    max-width: 1080px;
    margin: auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 25px;
    align-items: center;
  }

  .footer-logo {
    color: #ffffff;
  }

  .footer-container p {
    font-size: 13px;
    color: #c2d4cc;
  }

  .footer-links {
    display: flex;
    gap: 22px;
    font-size: 13px;
  }

  .copyright {
    grid-column: 1 / -1;
    padding-top: 20px;
    border-top: 1px solid #426158;
  }

  @media (max-width: 650px) {
    .nav-container {
      min-height: 68px;
      padding: 12px 18px;
      flex-wrap: wrap;
    }

    nav {
      width: 100%;
      justify-content: space-between;
      gap: 12px;
    }

    .hero {
      padding: 70px 22px;
    }

    .hero h1 {
      font-size: 38px;
    }

    .content-section {
      padding: 55px 20px;
    }

    .service-grid {
      grid-template-columns: 1fr;
    }

    .divider {
      margin: 45px 0;
    }

    .contact-cta {
      padding: 38px 22px;
      margin-top: 50px;
    }

    .footer-container {
      grid-template-columns: 1fr;
    }

    .footer-links {
      flex-wrap: wrap;
    }

    .copyright {
      grid-column: auto;
    }
  }
</style>
